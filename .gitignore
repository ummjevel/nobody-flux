# nobody-flux will be its own git repo (github.com/ummjevel/nobody-flux),
# separate from the parent `todak` workspace, so it needs its own rules
# rather than relying on that repo's top-level .gitignore.

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Virtual environments (this project's own, and MOSS-TTS-Nano's isolated one)
.venv/
**/.venv/

# Secrets / local environment
.env
.env.*
!.env.example

# Large model assets -- fetched by scripts/setup_common.sh, not committed
models/**/*.onnx
models/**/*.gguf
models/**/*.safetensors

# sherpa-onnx Matcha-TTS checkpoints (English + Korean) -- entire directories
# fetched/placed by scripts/setup_common.sh (or by hand, for the Korean one),
# including their non-weight auxiliary files (tokens.txt, README.md,
# espeak-ng-data/), same "not committed" rule as the weights above.
models/sherpa-matcha-en/
models/sherpa-matcha-ko/

# Streaming Zipformer Korean ASR checkpoint (encoder/decoder/joiner onnx +
# tokens.txt/bpe.model/test_wavs) -- whole directory fetched by
# scripts/setup_common.sh, not committed. Same rule as the weights above.
models/streaming-zipformer-ko/

# Supertonic 3 TTS checkpoint -- whole directory, and the whole directory
# specifically because the *.onnx rule above is not enough here: this bundle
# carries model data in `voice.bin` (the 10 speaker styles) and
# `unicode_indexer.bin`, neither of which matches an extension rule above, so
# without this line they would be committed.
#
# They must not be. The weights are OpenRAIL-M, not MIT -- note that the
# LICENSE file *inside* the bundle says MIT, which is Supertone's license for
# their sample code, while the upstream README in the same directory states the
# model is OpenRAIL-M. Committing them would redistribute OpenRAIL-M artifacts
# from this repo and drag its downstream-obligation clauses along with it.
models/sherpa-supertonic-3/
models/sherpa-supertonic-2/

# External repo, cloned by scripts/setup_common.sh, not committed
external/

# Audio / conversation data (reference voice clips, recorded turns, DB) --
# these are personal voice recordings, never ship them in a public repo.
data/*.wav
data/voices/
data/sessions/
data/benchmark_wavs/
data/*.db
data/*.db-journal

# Scratch output from the debug/calibration scripts (data/tmp/*.wav was NOT
# covered by data/*.wav above -- that pattern only matches direct children).
data/tmp/

# Prompt-prefix KV snapshots written by NobodyLLMGguf.warm_up(). Derived cache,
# ~75MB each, keyed to one model file's size+mtime on one machine -- so it is
# both too big to commit and meaningless on any other host.
data/kv-prefix/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local Claude Code settings (machine-specific permissions, not project config)
.claude/
