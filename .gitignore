# nobody-flux will be its own git repo (github.com/ummjevel/nobody-flux),
# separate from the parent `todak` workspace, so it needs its own rules
# rather than relying on that repo's top-level .gitignore.

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Virtual environments (this project's own, and MOSS-TTS-Nano's isolated one)
.venv/
**/.venv/

# Secrets / local environment
.env
.env.*
!.env.example

# Large model assets -- fetched by scripts/setup_common.sh, not committed
models/**/*.onnx
models/**/*.gguf
models/**/*.safetensors

# External repo, cloned by scripts/setup_common.sh, not committed
external/

# Audio / conversation data (reference voice clips, recorded turns, DB) --
# these are personal voice recordings, never ship them in a public repo.
data/*.wav
data/voices/
data/sessions/
data/*.db
data/*.db-journal

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
