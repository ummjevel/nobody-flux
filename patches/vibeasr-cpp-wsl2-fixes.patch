+    // total latency, for two calls that don't need each other's results.
+    //
+    // Safety: each thread gets its OWN vae_context_t (vae_ctx / this
+    // process's persistent context, and vae_ctx_semantic, created alongside
+    // it in main() from the same vae_model). vae_encode_impl() (vae.cpp)
+    // frees and reallocates ctx->compute_ctx on every call -- sharing one
+    // vae_context_t between these two threads would race on that. The
+    // vae_model itself (weights) is read-only during inference, so sharing
+    // *that* across both contexts is fine.
+    //
+    // Measured result: ~1.8s combined (was ~2.1s sequential) -- real, but
+    // well short of the naive ~1.05s (i.e. max() instead of sum()) you'd
+    // hope for from two independent, non-competing threads. Thread-count
+    // sweeps (6/8/12/16 threads per context) all landed in the same
+    // 1.7-1.95s band, so it isn't an undertuned thread count either --
+    // something else (memory bandwidth contention between the two
+    // concurrent compute graphs, most likely, given both are matmul-heavy
+    // over the same-sized audio) caps the win here. Still a real ~15-20%
+    // cut for zero quality cost, just not the 2x this comment used to imply.
     std::vector<float> acoustic_features(expected_frames * acoustic_dim);
+    std::vector<float> semantic_features(expected_frames * semantic_dim);
     float acoustic_time_ms = 0.0f;
-    int32_t acoustic_frames = vae_encode_acoustic_with_timing(
-        vae_ctx, audio.samples.data(), n_samples,
-        acoustic_features.data(), &acoustic_time_ms);
+    float semantic_time_ms = 0.0f;
+    int32_t acoustic_frames = 0;
+    int32_t semantic_frames = 0;
+
+    std::thread acoustic_thread([&]() {
+        acoustic_frames = vae_encode_acoustic_with_timing(
+            vae_ctx, audio.samples.data(), n_samples,
+            acoustic_features.data(), &acoustic_time_ms);
+    });
+    std::thread semantic_thread([&]() {
+        semantic_frames = vae_encode_semantic_with_timing(
+            vae_ctx_semantic, audio.samples.data(), n_samples,
+            semantic_features.data(), &semantic_time_ms);
+    });
+    acoustic_thread.join();
+    semantic_thread.join();
 
     if (acoustic_frames < 0) {
         fprintf(stdout, "[ERROR] VAE acoustic encoding failed\n---END---\n");
@@ -168,13 +211,6 @@ static int process_chunk(
     }
